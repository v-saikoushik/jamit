# Root environment template — copy to .env and per-service folders

# MongoDB
MONGODB_URI=mongodb://localhost:27017/jamit

# JWT (backend)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Backend
PORT=3001
AI_SERVICE_URL=http://localhost:8000
UPLOAD_DIR=./uploads
CORS_ORIGIN=http://localhost:5173

# AI Service
AI_MOCK_MODE=true
AI_PORT=8000

# Frontend (Vite)
VITE_API_URL=http://localhost:3001/api
